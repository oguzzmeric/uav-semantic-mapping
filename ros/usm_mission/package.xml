<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usm_mission</name>
  <version>0.1.0</version>
  <description>Mission and offboard flight control for uav-semantic-mapping.</description>
  <maintainer email="oguzmeric9@gmail.com">Oguz Umut Meric</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
